{
  "$schema": "./scripts/operations/schema.json",
  "version": 1,
  "stack": "backend-ts",
  "runtime": "server",
  "environments": ["local", "development", "production"],
  "services": [
    {
      "name": "api",
      "runtime": "server",
      "command": "bun run dev",
      "port": 8787,
      "healthcheck": "http://127.0.0.1:8787/health",
      "secretsTarget": ".dev.vars",
      "localHostname": "local-api.example.com"
    }
  ],
  "infisical": { "secretPath": "/" },
  "cloudflare": {
    "zone": "example.com",
    "tunnelName": "example-local",
    "deploy": {
      "development": {
        "worker": "example-dev",
        "command": "bun run deploy:development"
      },
      "production": {
        "worker": "example",
        "command": "bun run deploy"
      }
    }
  }
}

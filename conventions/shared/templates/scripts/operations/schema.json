{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://falconiere.github.io/toolu-conventions/operations.schema.json",
  "title": "toolu operations configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "stack", "runtime", "environments", "services"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "stack": {
      "enum": ["console", "marketing", "backend-ts", "expo", "rust", "workspace"]
    },
    "runtime": { "enum": ["client", "static", "server", "mixed"] },
    "environments": {
      "const": ["local", "development", "production"]
    },
    "services": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "runtime", "command", "port"],
        "dependentRequired": {
          "localHostname": ["healthcheck"]
        },
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "runtime": { "enum": ["client", "static", "server"] },
          "command": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_./:@%+=,-]+( [A-Za-z0-9_./:@%+=,-]+)*$",
            "description": "A whitespace-separated executable and arguments. Shell operators, expansion, quoting, and redirection are not supported; put complex composition in a repository-owned script."
          },
          "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
          "healthcheck": { "type": "string", "pattern": "^https?://" },
          "secretsTarget": { "type": "string", "minLength": 1 },
          "localHostname": { "type": "string", "minLength": 1 }
        }
      }
    },
    "infisical": {
      "type": "object",
      "additionalProperties": false,
      "required": ["secretPath"],
      "properties": {
        "secretPath": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(/[A-Za-z0-9_-][A-Za-z0-9_.-]*)*/?$",
          "description": "An absolute Infisical provider path without dot or traversal segments."
        }
      }
    },
    "cloudflare": {
      "type": "object",
      "additionalProperties": false,
      "required": ["zone", "tunnelName", "deploy"],
      "properties": {
        "zone": { "type": "string", "minLength": 1 },
        "tunnelName": { "type": "string", "minLength": 1 },
        "deploy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["development", "production"],
          "properties": {
            "development": { "$ref": "#/$defs/deploy" },
            "production": { "$ref": "#/$defs/deploy" }
          }
        }
      }
    }
  },
  "$defs": {
    "deploy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["worker", "command"],
      "properties": {
        "worker": { "type": "string", "minLength": 1 },
        "command": { "type": "string", "minLength": 1 },
        "migrateCommand": { "type": "string", "minLength": 1 },
        "checkCommand": { "type": "string", "minLength": 1 },
        "databaseUrlEnv": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" }
      }
    }
  }
}

# Infisical machine identity. Merge these names into .env.example; keep their
# real values in an ignored .env locally and the CI secret store remotely.
# Bootstrap values must be single-line; multiline and escaped-quote dotenv
# syntax is intentionally unsupported by the dependency-free safe parser.
INFISICAL_URL=https://app.infisical.com
INFISICAL_PROJECT_ID=
INFISICAL_MACHINE_IDENTITY_CLIENT_ID=
INFISICAL_MACHINE_IDENTITY_CLIENT_SECRET=

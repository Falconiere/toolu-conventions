{
  "name": "<project-name>",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "check": "bun --filter '*' run check",
    "type-check": "bun --filter '*' run type-check",
    "lint": "bun --filter '*' run lint",
    "fmt:check": "bun --filter '*' run fmt:check",
    "check:structure": "bash scripts/guardrails/run.sh",
    "check:unused": "knip",
    "check:dupes": "bun --filter '*' run check:dupes",
    "test": "bun --filter '*' run test"
  },
  "devDependencies": {
    "knip": "^5.64.4",
    "lefthook": "^2.1.4"
  }
}

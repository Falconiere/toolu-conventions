{
  "$schema": "./node_modules/knip/schema.json",
  "workspaces": {
    ".": { "entry": [], "project": [] },
    "packages/api": {
      "entry": ["src/index.ts", "vitest.config.ts"],
      "project": ["src/**/*.ts"],
      "ignore": ["worker-configuration.d.ts"],
      "ignoreBinaries": ["wrangler"]
    },
    "packages/database": {
      "entry": [
        "src/client/create-database.ts",
        "src/schema/tables.ts",
        "src/types/database.ts",
        "vitest.config.ts",
        "drizzle.config.ts"
      ],
      "project": ["src/**/*.ts"],
      "ignoreBinaries": ["wrangler", "drizzle-kit"]
    }
  }
}

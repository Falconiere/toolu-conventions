# Copy to `.env.local` (git-ignored) and fill in. Only VITE_* vars reach the
# browser bundle — this is a static SPA, so EVERYTHING in this file ships to the
# client. Never put a secret here.
#
# NOTE: VITE_* are inlined at build time at direct `import.meta.env.VITE_X`
# access sites only (see src/constants/env.ts). Adding a new public var means
# reading it via its full static path there and validating it in the same file.

# Which logical environment this deploy targets.
VITE_ENV=development

# Base URL for the API (omit to use the local dev default in src/constants/env.ts).
# VITE_API_URL=https://api.dev.example.com

# --- Secrets do NOT belong here ---
# Server-side values (TURSO_AUTH_TOKEN, AUTH_SECRET, API keys) live in the
# backend service, or — if you opted into the same-project Worker API — in
# `.dev.vars` locally and `wrangler secret put` for deployed environments.

{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "{{PROJECT_NAME}}",
  // Pin to the date you scaffolded on. Bumping it opts into newer runtime
  // behaviour — do it deliberately, not as a drive-by.
  "compatibility_date": "2026-07-30",

  // A console with no Worker script of its own: Cloudflare serves the Vite
  // build straight from the edge. `single-page-application` returns index.html
  // with 200 for any path that is not a built asset, which is what TanStack
  // Router needs for a deep link like /shifts/42 to boot the app.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },

  // Only if you opted into a same-project Worker API (SETUP.md Phase 6c):
  //   "main": "./src/worker.ts",
  //   "assets": { ..., "binding": "ASSETS" },
  //   "compatibility_flags": ["nodejs_compat"]
  // With the Vite plugin, "directory" is dropped — it points at the client
  // build output automatically.

  // Staging is one more deploy target, not another codebase. Uncomment when the
  // intake asked for it, then deploy with `wrangler deploy --env staging`.
  // "env": {
  //   "staging": {
  //     "name": "{{PROJECT_NAME}}-staging"
  //   }
  // },

  "observability": {
    "enabled": true
  }
}

{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": [
    "./base.oxlintrc.json",
    "./base-react.oxlintrc.json"
  ],
  "plugins": [
    "jsx-a11y"
  ],
  "env": {
    "browser": true,
    "node": true,
    "es2024": true
  },
  "ignorePatterns": [
    "node_modules",
    "dist",
    ".wrangler",
    "coverage",
    "src/route-tree.gen.ts",
    "worker-configuration.d.ts"
  ],
  "rules": {
    "max-lines": [
      "error",
      {
        "max": 300,
        "skipBlankLines": true,
        "skipComments": true
      }
    ],
    "max-lines-per-function": [
      "error",
      {
        "max": 50,
        "skipBlankLines": true,
        "skipComments": true
      }
    ],
    "no-console": [
      "warn",
      {
        "allow": [
          "warn",
          "error"
        ]
      }
    ],
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": [
              "**/index",
              "**/index.js",
              "**/index.ts",
              "**/index.tsx"
            ],
            "message": "No barrel imports - import the concrete file"
          },
          {
            "group": [
              "../../*",
              "../../**"
            ],
            "message": "No deep relative imports - use @/ aliases"
          },
          {
            "group": [
              "@/features/*",
              "@/features/**"
            ],
            "message": "Features are isolated - only route files import feature screens"
          },
          {
            "group": [
              "axios",
              "axios/*"
            ],
            "message": "No axios - use the fetch client in @/utilities/http"
          },
          {
            "group": [
              "yup",
              "joi",
              "valibot",
              "superstruct",
              "ajv"
            ],
            "message": "One validator: use zod (CORE rule 13)"
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "src/main.tsx"
      ],
      "rules": {
        "import/no-unassigned-import": "off"
      }
    },
    {
      "files": [
        "src/app/**/*.{ts,tsx}"
      ],
      "rules": {
        "unicorn/filename-case": "off",
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "**/index",
                  "**/index.js",
                  "**/index.ts",
                  "**/index.tsx"
                ],
                "message": "No barrel imports - import the concrete file"
              },
              {
                "group": [
                  "../../*",
                  "../../**"
                ],
                "message": "No deep relative imports - use @/ aliases"
              },
              {
                "group": [
                  "axios",
                  "axios/*"
                ],
                "message": "No axios - use the fetch client in @/utilities/http"
              },
              {
                "group": [
                  "yup",
                  "joi",
                  "valibot",
                  "superstruct",
                  "ajv"
                ],
                "message": "One validator: use zod (CORE rule 13)"
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "*.config.{ts,js,mjs}",
        "vite.config.ts"
      ],
      "rules": {
        "max-lines": "off",
        "import/no-default-export": "off",
        "max-lines-per-function": "off"
      }
    },
    {
      "files": [
        "**/__tests__/**/*.{ts,tsx}",
        "**/*.test.{ts,tsx}",
        "vitest.setup.ts"
      ],
      "rules": {
        "max-lines": "off",
        "typescript/no-explicit-any": "off",
        "typescript/no-non-null-assertion": "off",
        "typescript/consistent-type-assertions": "off",
        "typescript/no-unsafe-assignment": "off",
        "typescript/no-unsafe-call": "off",
        "typescript/no-unsafe-member-access": "off",
        "typescript/no-unsafe-argument": "off",
        "typescript/no-floating-promises": "off",
        "no-console": "off",
        "max-lines-per-function": "off"
      }
    },
    {
      "files": [
        "**/*.tsx"
      ],
      "rules": {
        "max-lines-per-function": [
          "error",
          {
            "max": 80,
            "skipBlankLines": true,
            "skipComments": true
          }
        ]
      }
    }
  ]
}

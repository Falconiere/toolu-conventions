# Copy to `.env` (git-ignored) and fill in. Only EXPO_PUBLIC_* vars are exposed
# to the app bundle. Create `.env.staging` too if you enabled a staging env.
#
# .gitignore must ignore the real env files but keep THIS example — the two lines,
# in order:
#   .env*
#   !.env.example
#
# NOTE: these are inlined at build time at direct `process.env.EXPO_PUBLIC_X`
# access sites only (see src/constants/env.ts). Adding a new var here means
# reading it via its full static `process.env.EXPO_PUBLIC_X` path in that file
# and validating it there.

# Which logical environment this build targets.
EXPO_PUBLIC_ENV=development

# Base URL for the API (omit to use the local dev default in src/constants/env.ts).
# EXPO_PUBLIC_API_URL=<api-base-url>

# --- Add integration keys here as you wire them (kept out of git) ---
# EXPO_PUBLIC_SENTRY_DSN=
# EXPO_PUBLIC_LAUNCH_DARKLY_ID=

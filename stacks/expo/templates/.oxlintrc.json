{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "options": {
    "typeAware": true
  },
  "plugins": ["react", "typescript", "import", "unicorn", "promise", "oxc"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error",
    "restriction": "off",
    "style": "off",
    "nursery": "off"
  },
  "env": {
    "browser": true,
    "node": true,
    "es2024": true
  },
  "globals": {
    "__DEV__": "readonly",
    "process": "readonly"
  },
  "ignorePatterns": ["node_modules", ".expo", "android", "ios", "dist", "assets", "babel.config.js", "metro.config.js"],
  "rules": {
    "max-lines": ["error", { "max": 300, "skipBlankLines": true, "skipComments": true }],
    "no-restricted-imports": ["error", {
      "patterns": [
        { "group": ["**/index", "**/index.js", "**/index.ts", "**/index.tsx"], "message": "No barrel imports - import the concrete file" },
        { "group": ["../../*", "../../**"], "message": "No deep relative imports - use @/ aliases" },
        { "group": ["@/features/*", "@/features/**"], "message": "Features are isolated - only route files import feature screens" }
      ]
    }],
    "react/jsx-key": "error",
    "react/jsx-no-duplicate-props": "error",
    "react/no-array-index-key": "error",
    "react/self-closing-comp": "error",
    "react/react-in-jsx-scope": "off",
    "react-hooks/rules-of-hooks": "error",
    "react-hooks/exhaustive-deps": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-unused-vars": ["error", { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }],
    "typescript/consistent-type-imports": "error",
    "typescript/prefer-as-const": "error",
    "typescript/consistent-type-assertions": ["error", { "assertionStyle": "never" }],
    "typescript/no-non-null-assertion": "error",
    "typescript/no-unnecessary-type-assertion": "error",
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-call": "error",
    "typescript/no-unsafe-member-access": "error",
    "typescript/no-unsafe-argument": "error",
    "typescript/no-unsafe-return": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/await-thenable": "error",
    "typescript/require-await": "error",
    "typescript/no-unnecessary-condition": "error",
    "typescript/prefer-nullish-coalescing": "error",
    "typescript/prefer-optional-chain": "error",
    "typescript/switch-exhaustiveness-check": "error",
    "import/no-cycle": "error",
    "import/no-self-import": "error",
    "import/no-duplicates": "error",
    "unicorn/filename-case": ["error", { "case": "kebabCase" }],
    "unicorn/prefer-node-protocol": "error",
    "promise/no-return-wrap": "error",
    "promise/catch-or-return": "error",
    "no-console": ["error", { "allow": ["warn", "error"] }],
    "no-debugger": "error",
    "eqeqeq": ["error", "always", { "null": "ignore" }],
    "prefer-const": "error",
    "no-var": "error"
  },
  "overrides": [
    {
      "files": ["app/**/*.{ts,tsx}"],
      "rules": {
        "import/no-default-export": "off",
        "unicorn/filename-case": "off",
        "no-restricted-imports": ["error", {
          "patterns": [
            { "group": ["**/index", "**/index.js", "**/index.ts", "**/index.tsx"], "message": "No barrel imports - import the concrete file" },
            { "group": ["../../*", "../../**"], "message": "No deep relative imports - use @/ aliases" }
          ]
        }]
      }
    },
    {
      "files": ["**/__tests__/**/*.{ts,tsx}", "**/*.test.{ts,tsx}", "jest.setup.ts"],
      "rules": {
        "max-lines": "off",
        "typescript/no-explicit-any": "off",
        "typescript/no-non-null-assertion": "off",
        "typescript/consistent-type-assertions": "off",
        "typescript/no-unsafe-assignment": "off",
        "typescript/no-unsafe-call": "off",
        "typescript/no-unsafe-member-access": "off",
        "typescript/no-unsafe-argument": "off",
        "typescript/no-floating-promises": "off",
        "import/no-unassigned-import": "off",
        "no-console": "off"
      }
    },
    {
      "files": ["*.config.{ts,js}", "*.d.ts"],
      "rules": {
        "max-lines": "off"
      }
    }
  ]
}

# Copy to `.env` (git-ignored) and fill in. Bun loads `.env` natively — no dotenv.
# Every var is validated at startup in src/constants/env.ts; add a new one there
# too, or the app ignores it.

# Logical environment: development | staging | production
APP_ENV=development

# Port the server listens on (defaults to 3000 if unset).
PORT=3000

# --- Integrations (uncomment as you wire them; validate each in env.ts) ---

# Bearer token the auth middleware accepts (auth integration).
# AUTH_TOKEN=

# Postgres connection string for bun:sql / drizzle (DB integration).
# DATABASE_URL=postgres://user:pass@localhost:5432/app

# Pino level: fatal | error | warn | info | debug | trace (logging integration).
# LOG_LEVEL=info

{
  "name": "@<project-name>/database",
  "private": true,
  "type": "module",
  "exports": {
    "./client": "./src/client/create-database.ts",
    "./schema": "./src/schema/tables.ts",
    "./types": "./src/types/database.ts"
  },
  "scripts": {
    "check": "bun run typecheck && bun run lint && bun run test && bash scripts/guardrails/run.sh",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware && oxfmt --check .",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@libsql/client": "^0.16.0",
    "drizzle-orm": "^0.45.2",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.20.2",
    "drizzle-kit": "^0.32.0",
    "oxlint": "^1.77.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0",
    "wrangler": "^4.45.0"
  }
}

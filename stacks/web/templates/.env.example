# Copy to `.env.local` (git-ignored) and fill in. Only NEXT_PUBLIC_* vars reach
# the browser bundle; everything without that prefix stays server-only.
#
# NOTE: NEXT_PUBLIC_* are inlined at build time at direct
# `process.env.NEXT_PUBLIC_X` access sites only (see src/constants/env.ts).
# Adding a new public var means reading it via its full static path there and
# validating it in the same file.

# Which logical environment this deploy targets.
NEXT_PUBLIC_ENV=development

# Base URL for the API (omit to use the local dev default in src/constants/env.ts).
# NEXT_PUBLIC_API_URL=https://api.dev.example.com

# --- Server-only secrets (never prefixed NEXT_PUBLIC_, never sent to the client) ---
# AUTH_SECRET=
# DATABASE_URL=

{
  "$schema": "./scripts/guardrails/schema.json",
  "version": 2,
  "srcRoot": "src",
  "src": {
    "topLevel": [
      "domains",
      "config",
      "error",
      "utilities",
      "cli",
      "http"
    ],
    "nested": {
      "domains/*": [
        "tests",
        "model",
        "service",
        "store"
      ],
      "cli": [
        "tests"
      ],
      "http": [
        "tests"
      ],
      "config": [
        "tests"
      ],
      "error": [
        "tests"
      ],
      "utilities": [
        "tests"
      ]
    },
    "requireReadme": [
      "domains"
    ]
  },
  "fileSize": {
    "max": 500,
    "skipExtensions": []
  },
  "functionSize": {
    "max": 100
  },
  "testDir": "tests",
  "testGlob": "",
  "barrelNames": [
    "mod.rs"
  ],
  "barrelExempt": [],
  "bannedDeps": [],
  "filenameCase": [
    {
      "glob": "*.rs",
      "regex": "^[a-z0-9_]+[.]rs$",
      "describe": "snake_case"
    }
  ],
  "secrets": {
    "neverTracked": [
      ".env"
    ]
  },
  "shadowConfigs": [
    {
      "found": "lefthook.yaml",
      "use": "lefthook.yml",
      "why": "the lefthook 2.x installer shadows a .yaml, so the hooks never run"
    }
  ],
  "ownedByLinter": []
}

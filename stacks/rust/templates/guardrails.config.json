{
  "$schema": "./scripts/guardrails/schema.json",
  "version": 1,
  "srcRoot": "src",
  "src": {
    "nested": {
      "*": [
        "tests"
      ]
    }
  },
  "fileSize": {
    "max": 500,
    "skipExtensions": []
  },
  "functionSize": {
    "max": 100
  },
  "testDir": "tests",
  "testGlob": "",
  "barrelNames": [],
  "barrelExempt": [],
  "bannedDeps": [],
  "filenameCase": [
    {
      "glob": "*.rs",
      "regex": "^[a-z0-9_]+[.]rs$",
      "describe": "snake_case"
    }
  ],
  "secrets": {
    "neverTracked": [
      ".env"
    ]
  },
  "shadowConfigs": [
    {
      "found": "lefthook.yaml",
      "use": "lefthook.yml",
      "why": "the lefthook 2.x installer shadows a .yaml, so the hooks never run"
    }
  ]
}

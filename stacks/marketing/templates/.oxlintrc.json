{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": [
    "./base.oxlintrc.json"
  ],
  "env": {
    "browser": true,
    "node": true,
    "es2024": true
  },
  "ignorePatterns": [
    "node_modules",
    "dist",
    ".astro",
    ".wrangler",
    "coverage"
  ],
  "rules": {
    "max-lines": [
      "error",
      {
        "max": 300,
        "skipBlankLines": true,
        "skipComments": true
      }
    ],
    "max-lines-per-function": [
      "error",
      {
        "max": 50,
        "skipBlankLines": true,
        "skipComments": true
      }
    ],
    "no-console": [
      "warn",
      {
        "allow": [
          "warn",
          "error"
        ]
      }
    ],
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": [
              "**/index",
              "**/index.js",
              "**/index.ts",
              "**/index.tsx"
            ],
            "message": "No barrel imports - import the concrete file"
          },
          {
            "group": [
              "../../*",
              "../../**"
            ],
            "message": "No deep relative imports - use @/ aliases"
          },
          {
            "group": [
              "@/ui/theme/colors",
              "@/ui/theme/spacing",
              "@/ui/theme/typography",
              "@/ui/theme/motion",
              "**/ui/theme/colors",
              "**/ui/theme/spacing",
              "**/ui/theme/typography",
              "**/ui/theme/motion"
            ],
            "message": "Web style tokens live in CSS - use ui/theme/palette.css or scale.css (a TS colour cannot follow .band-light)"
          },
          {
            "group": [
              "axios",
              "axios/*"
            ],
            "message": "No axios - use the fetch client in @/utilities/http"
          },
          {
            "group": [
              "yup",
              "joi",
              "valibot",
              "superstruct",
              "ajv"
            ],
            "message": "One validator: use zod (CORE rule 13)"
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "src/layouts/**/*.astro"
      ],
      "rules": {
        "import/no-unassigned-import": "off"
      }
    },
    {
      "files": [
        "*.config.{ts,js,mjs}",
        "astro.config.mjs",
        "vitest.config.ts",
        "src/content.config.ts"
      ],
      "rules": {
        "max-lines": "off",
        "import/no-default-export": "off",
        "max-lines-per-function": "off"
      }
    },
    {
      "files": [
        "**/__tests__/**/*.{ts,tsx}",
        "**/*.test.{ts,tsx}"
      ],
      "rules": {
        "max-lines": "off",
        "typescript/no-explicit-any": "off",
        "typescript/no-non-null-assertion": "off",
        "typescript/consistent-type-assertions": "off",
        "typescript/no-unsafe-assignment": "off",
        "typescript/no-unsafe-call": "off",
        "typescript/no-unsafe-member-access": "off",
        "typescript/no-unsafe-argument": "off",
        "typescript/no-floating-promises": "off",
        "no-console": "off",
        "max-lines-per-function": "off"
      }
    }
  ]
}

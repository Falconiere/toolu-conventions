# Copy to `.env` (git-ignored) and fill in. This is a STATIC site: every value
# here is baked into the HTML that ships. Nothing in this file is a secret, and
# nothing secret may be added to it.
#
# NOTE: PUBLIC_* are inlined at build time at direct `import.meta.env.PUBLIC_X`
# access sites only (see src/constants/env.ts). Adding a new var means reading
# it via its full static path there and validating it in the same file.

# Which logical environment this build targets.
PUBLIC_ENV=development

# Where "Log in" / "Get started" point — the console app.
# PUBLIC_CONSOLE_URL=https://app.example.com

# Build-time only (no PUBLIC_ prefix, so it never reaches the browser).
# astro.config.mjs reads it to override `site` — set it on a staging build so
# canonical URLs and the sitemap point at staging instead of production.
# SITE_URL=https://staging.example.com

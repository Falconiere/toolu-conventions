---
/** `/404` — served with a real 404 status by Workers (not_found_handling: "404-page"). */
import BaseLayout from '@/layouts/base-layout.astro';
---

<BaseLayout title="Not found — {{TOOLU_DISPLAY_NAME}}" description="That page does not exist.">
  <main class="band">
    <p>404</p>
    <h1>That page does not exist.</h1>
    <a href="/">Back to the home page</a>
  </main>
</BaseLayout>
